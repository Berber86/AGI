{
  "name": "cog-empires",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Механизм Цивилизации (Cog Empires) — стратегия с деревом технологий, шестерёнками-экипировкой и пошаговым автотактическим боем.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
