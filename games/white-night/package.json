{
  "name": "white-night-finds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "node --check src/main.js && node --check src/world.js && node --check src/models.js && node --check src/state.js && node --check src/materials.js",
    "test": "node --test tests/state.test.js",
    "build": "vite build && node scripts/service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node tests/e2e.mjs",
    "gate": "npm run check && npm test && npm run build && npm run test:e2e",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "138.0.2",
    "puppeteer-core": "25.14.0",
    "sharp": "0.35.5",
    "vite": "6.4.4"
  }
}
