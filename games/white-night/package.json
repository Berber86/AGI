{
  "name": "white-night-finds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "node --check src/main.js && node --check src/world.js && node --check src/models.js && node --check src/state.js && node --check src/materials.js && node --check src/rendering.js && node --check src/scenery.js && node --check src/sculpt.js && node --check src/presentation.js && node --check src/environment.js && node --check src/aging.js && node --check src/reveal.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build && node scripts/service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node tests/e2e.mjs",
    "gate": "npm run check && npm test && npm run build && npm run test:e2e",
    "test:desktop": "node tests/desktop.mjs",
    "export:static": "npm run build && node scripts/export-static.mjs",
    "test:catalog": "node tests/catalog.mjs",
    "test:art": "node tests/art-review.mjs",
    "materials": "node scripts/material-maps.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:thumbnails": "node tests/thumbnails.mjs",
    "test:scene": "node tests/scene-review.mjs",
    "test:reveal": "node tests/reveal.mjs",
    "test:landscape": "node tests/landscape.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "138.0.2",
    "puppeteer-core": "25.14.0",
    "sharp": "0.35.5",
    "vite": "6.4.4"
  }
}
