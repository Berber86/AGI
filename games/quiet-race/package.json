{
  "name": "quiet-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Тихая гонка — неспешная гонка для маленькой гонщицы: без проигрыша, с обгонами друзей и финишем-праздником",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qa": "vite build --config vite.headless.config.ts && node scripts/headless-run.mjs",
    "qa:offline": "vite build --config vite.offline.config.ts && node scripts/headless-run.mjs --offline",
    "build:offline": "vite build --config vite.offline.config.ts",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
